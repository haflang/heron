lte x y = x <= y
gt x y = not (x <= y)

quicksortPar n xs =
  if n == 0
    then quicksort xs
    else case xs of
      [] -> []
      (pivot:rest) ->
        let low  = quicksortPar (n-1) (filter (gt pivot) rest)
            high = quicksortPar (n-1) (filter (lte pivot) rest) `using` evalList rseq
        in high `par` low ++ [pivot] ++ high

quicksort [] = []
quicksort (pivot:rest) = case rest of
  [] -> [pivot]
  (y:ys) -> let low  = quicksort $ filter (gt pivot) rest
                high = quicksort $ filter (lte pivot) rest
            in low ++ [pivot] ++ high

-- Version with ideal input
-- Each sublist should be equal size

interleave xs ys =
  if null xs
    then ys
    else if null ys
            then xs
            else head xs : interleave ys (tail xs)

inps l u =
  let mid = (((u-l)+1) `div` 2) + l
      ls  = inps l (mid-1)
      us  = inps (mid+1) u
  in mid : interleave ls us
genInps n = take n $ inps 0 n

threshold = 3
main =
  let
      largeInp = genInps 800 `using` evalList rseq -- 1000
      sorted = quicksort largeInp -- Par threshold largeInp
  in maximum sorted

{-

-- Version that riffle shuffles the input

rep n xs = if n == 0 then []
                     else xs ++ rep (n-1) xs

randomise = shuffle 2

shuffle n xs =
  if n == 0
    then xs
    else shuffle (n-1) (riffle xs)

riffle [] = []
riffle (x0:xs0) =
  let xs = x0:xs0
  in case splitAt ((length xs) `div` 2) xs of
       (ys, zs) -> interleave ys zs

interleave xs ys =
  if null xs
    then ys
    else if null ys
            then xs
            else head xs : interleave ys (tail xs)

-- This is a bad implementation of splitAt. The first list is reversed, but that's OK here.
splitAt n xs = splitAt' [] n xs
splitAt' acc n [] = (acc, [])
splitAt' acc n (x:xs) =
  if n == 0
    then (acc, x:xs)
    else splitAt' (x:acc) (n-1) xs

threshold = 5
main =
  let
      largeInp = randomise (enumFromTo 0 1200) -- `using` evalList r0
      sorted = quicksortPar threshold largeInp
  in maximum sorted
-}

