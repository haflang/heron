{-
This is a tricky one!

We have unpredictably sized tasks in the solver (depending on game state), so we
really need some sort of task context switching to keep both busy.

Worse still is that the main solver uses short circuiting via foldr1 with a
function lazy in its second argument (bestOf). If we chose to spark all the
possible moves, there's a good chance that we will be doing speculative
parallism, and probably wasting time!

-}

data Outcome =
    Draw
  | Loss
  | Win

data Player =
    O
  | X

insert x [] = x : []
insert x (y : ys) =
  if x <= y
    then x : y : ys
    else y : insert x ys

bestOf Win  v = Win
bestOf Loss v = v
bestOf Draw Win = Win
bestOf Draw Draw = Draw
bestOf Draw Loss = Draw

inverse Loss = Win
inverse Draw = Draw
inverse Win  = Loss

cmp a b =
  if a == b
    then EQ
    else
      if a <= b
        then LT
        else GT

diff [] ys = []
diff (x : xs) [] = x : xs
diff (x : xs) (y : ys) =
  case cmp x y of
    LT -> x : diff xs (y : ys)
    EQ -> diff xs ys
    GT -> diff (x : xs) ys

subset xs ys = null (diff xs ys)

hasLine p =
  subset [1,2,3] p ||
  subset [4,5,6] p ||
  subset [7,8,9] p ||
  subset [1,4,7] p ||
  subset [2,5,8] p ||
  subset [3,6,9] p ||
  subset [1,5,9] p ||
  subset [3,5,7] p

gridFull ap pp = length ap + length pp == 9

analysis ap pp =
  if hasLine pp
    then Loss
    else
      if gridFull ap pp
        then Draw
        else let options = map (moveval ap pp) (diff (diff (enumFromTo 1 9) ap) pp) `using` parBuffer 7 rseq
             in foldr1 bestOf options

moveval ap pp m = inverse (analysis pp (insert m ap))

adjudicate os xs =
  case (cmp (length os) (length xs)) of
    GT -> report (analysis xs os) X
    LT -> report (analysis os xs) O
    EQ -> if hasLine xs
            then report Win X
            else if hasLine os
                   then report Win O
                   else report (analysis xs os) X

report Loss s = side (opp s)
report Win  s = side s
report Draw p = 'D'

opp O = X
opp X = O

side O = 'O'
side X = 'X'

main = adjudicate [1,3] [5]
-- ^ Player 2 has one good first choice, so there's unevenly sized tasks. Gets only x1.39

-- main = adjudicate [1,9] [7,3]
-- ^ Gets x1.73 with parList, early choices on a symmetric board will be more evenly sized

