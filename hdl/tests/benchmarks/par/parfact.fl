
pfc x y c =
  if (y-x) > c
    then let m = (x+y) `div` 2
             f1 = pfc x m c
             f2 = pfc (m+1) y c
         in f1 `par` f2 `seq` f1+f2
    else if x == y
           then x
           else let m = (x+y) `div` 2
                in pf x m + pf (m+1) y

pf x y =
  if y > x
    then let m = (x+y) `div` 2
         in pf x m + pf (m+1) y
    else x

parfact x c = pfc 1 x c

main = parfact 300 40
