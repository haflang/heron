inits xs =
  case xs of
    []       -> [[]]
    (y : ys) -> xs : inits (init xs)

tails ys =
  case ys of
    [] -> []
    (x : xs) -> ys : tails xs

segments xs = map tails (inits xs)

minBound = 0-16383
maxSum xs =
  let segSums = map sum xs
  in maximumGo minBound segSums

mss xs =
  let xss = segments xs `using` evalList r0
      sums = map maxSum xss `using` parList rseq
  in maximum sums

{-

Evaluating the segments spine isn't necessary, but it does avoid some nasty
suspend/resumes in parallel evaluation. What happens (I think) is that the work
of evaluating segments is stolen by another core while core 0 sparks the list.
Then core 0 chews through its spark pool, begining many of the threads, but they
all suspend quite quickly. Since we do not migrate suspended tasks to other PEs,
we destroy the opportunity for parallelism.

A more robust approach would be to use parBuffer (once our version really does
behave lazily). This would limit the number of sparks created (and later
suspended). After the initial few sparks, we'd expect enough of the segments
list to be constructed so we avoid this blocking.

-}

main = let n = 30
           xs = enumFromTo (0-n) n -- `using` evalList rseq
       in mss xs -- + mss xs + mss xs + mss xs
