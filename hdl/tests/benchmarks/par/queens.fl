nsoln nq = length (gen nq nq)

gen nq n =
  if n == 0
    then [[]]
    else
      if threshold > nq - n
        then let solns = map (tryAdd nq) (gen nq (n-1)) `using` parList (evalList (evalList rseq))
             in concat solns
        else concatMap (tryAdd nq) (gen nq (n-1))

tryAdd nq b = concatMap (whenSafe b) (toOne nq)

whenSafe b q = if safe q 1 b
                 then [q : b]
                 else []

safe x d [] = True
safe x d (q : l) =
  (x /= q)   &&
  (x /= q + d) &&
  (x /= q - d) &&
  safe x (d + 1) l

toOne n = if n == 1
  then [1]
  else n : toOne (n - 1)

threshold = 3

main = nsoln 6
