{-
Inspired by nofib/parallel/minimax

Description in https://www.microsoft.com/en-us/research/wp-content/uploads/2009/09/ghc-parallel-tuning2.pdf

Main changes are:
  + Outcome's should be `XWin | OWin | ScoreX Int`.
    It means we can pick _one_ best move, since we can rank moves that were previously `Draw`.
  + _Possibly_ better to have board cells possibly empty. We can do checking without difference lists, etc.

Simon Marlow uses parList for mapping best move over possible moves.
-}
data Outcome =
    Draw
  | Loss
  | Win

data Player =
    O
  | X

insert x [] = x : []
insert x (y : ys) =
  if x <= y
    then x : y : ys
    else y : insert x ys

bestOf Win  v = Win
bestOf Loss v = v
bestOf Draw Win = Win
bestOf Draw Draw = Draw
bestOf Draw Loss = Draw

inverse Loss = Win
inverse Draw = Draw
inverse Win  = Loss

cmp a b =
  if a == b
    then EQ
    else
      if a <= b
        then LT
        else GT

diff [] ys = []
diff (x : xs) [] = x : xs
diff (x : xs) (y : ys) =
  case cmp x y of
    LT -> x : diff xs (y : ys)
    EQ -> diff xs ys
    GT -> diff (x : xs) ys

subset xs ys = null (diff xs ys)

hasLine p =
  subset [1,2,3] p ||
  subset [4,5,6] p ||
  subset [7,8,9] p ||
  subset [1,4,7] p ||
  subset [2,5,8] p ||
  subset [3,6,9] p ||
  subset [1,5,9] p ||
  subset [3,5,7] p

gridFull ap pp = length ap + length pp == 9

parList []     = []
parList (x:xs) = x `par` parList xs

parMap f [] = []
parMap f (x:xs) = let y = f x
                      ys = parMap f xs
                  in y `par` ys `seq` y : ys

analysis ap pp =
  if hasLine pp
    then Loss
    else
      if gridFull ap pp
        then Draw
        else let options = map (moveval ap pp) (diff (diff (enumFromTo 1 9) ap) pp)
             in parList options `seq` foldr1 bestOf options

{-
          if length ap <= 5
             then let options = map (moveval ap pp) (diff (diff (enumFromTo 1 9) ap) pp)
                       in parList options `seq` foldr1 bestOf options
             else foldr1 bestOf (map (moveval ap pp) (diff (diff (enumFromTo 1 9) ap) pp))
-}

{-
-- Surprise is that we get about x1.4 even though both cores look busy. I think
-- this is because `bestOf` is only strict in it's first argument. Once `foldr1`
-- finds a `Win`, none of the rest of the list is actually needed.

-- One solution is to use chunking and fold the chunks in separate jobs.
parList []     = []
parList (x:xs) = x `par` parList xs

first  f (a,b) = (f a, b)
second f (a,b) = (a, f b)
cons x xs = x : xs
bisect [] = ([],[])
bisect (x:xs) = case xs of
  [] -> ([x], [])
  (y:ys) -> second (cons y) $ first (cons x) $ bisect ys

analysis ap pp =
  if hasLine pp
    then Loss
    else
      if gridFull ap pp
        then Draw
        else let moves = bisect (diff (diff (enumFromTo 1 9) ap) pp)
                 optsA = foldr bestOf Loss (map (moveval ap pp) (fst moves))
                 optsB = foldr bestOf Loss (map (moveval ap pp) (snd moves))
             in optsB `par` bestOf optsA optsB
-}

moveval ap pp m = inverse (analysis pp (insert m ap))

adjudicate os xs =
  case (cmp (length os) (length xs)) of
    GT -> report (analysis xs os) X
    LT -> report (analysis os xs) O
    EQ -> if hasLine xs
            then report Win X
            else if hasLine os
                   then report Win O
                   else report (analysis xs os) X

report Loss s = side (opp s)
report Win  s = side s
report Draw p = 'D'

opp O = X
opp X = O

side O = 'O'
side X = 'X'

main = adjudicate [1,3] [5]
