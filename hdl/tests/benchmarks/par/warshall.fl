-- ring size = parameter np
-- wr2 :: Int -> Matrix Int -> Matrix Int
wr2 = wr gphRing

-- gph ring, simply by sparking all ring process outputs
-- (granularity control by ring size)
gphRing np splitIn combOut ringF input
  = let ringIns = splitIn np input
        -- xs = foldl' (gphRingFld ringF) ([],snd xs) ringIns
        xs = foldWrap (gphRingFld ringF) xs ringIns
        outs = fst xs
    in combOut (outs `using` parList (evalList (evalList rseq)))

foldWrap f acc xs = foldl' f ([],snd acc) ([] ++ xs)

{- This is a similar hack
to that in `transclos.fl` to force letrec into a suitable shape for a one-ported
heap. The `[] ++` is just to push `foldWrap` over the size threshold that informs
inlining. We need it to avoid inlining so that there is only a single recursive
let bound application in the templates generated for `gphRing` -}

gphRingFld ringF (outs',rIn) inp =
  case ringF (inp,rIn) of
    (out,rOut) -> (out:outs', rOut)

-- type Matrix a = [[a]]
-- dim :: Matrix a -> Int
dim = length

-- wr :: ring skel type -> Int -> Matrix Int -> Matrix Int
wr ring np mat = ring np wrSplit concat wrRingf (mat,0) -- ring type issue, 0 is dummy parameter
--           ((some rows,start),more rows)  -> ( result rows , rows for ring)
-- wrRingf :: ((Matrix Int, Int), [[Int]] )  -> ( Matrix Int  ,   [[Int]])
wrRingf ((rows,startrow), fromLeft) = create_procs (length $ head rows) startrow rows fromLeft

--       ring size  all input    [ (some rows ,no. of 1st row)]
-- wrSplit :: Int -> (Matrix Int, Int) -> [ (Matrix Int,    Int      )]
wrSplit n (mat,a) =
  let inputrows = splitIntoN n mat
  in zip inputrows (scanl (+) 1 (map length inputrows))

