-- create_procs :: Int -> Int -> Matrix Int -> [[Int]] -> ([[Int]],[[Int]])
create_procs size k (rowk:restmat) inputleft =
  let xs = ring_iterate size k 1 rowk inputleft
      ys = create_procs size (k+1) restmat (snd xs)
  in case restmat of
       [] -> ([fst xs], snd xs)
       (r:rs) -> (fst xs : fst ys, snd ys)

-- ring_iterate :: Int -> Int -> Int -> [Int] -> [[Int]] -> ([Int],[[Int]])
ring_iterate size k i rowk rows =
  if i > size
    then (rowk, [])
    else let rowi = head rows
             xs   = tail rows
             sols = (nextrowk `using` evalList rseq) `seq` (ring_iterate size k (i+1) nextrowk xs)
             nextrowk = if i==k then rowk else  updaterow rowk rowi (rowk!!(i-1))
         in if i==k then (fst sols, rowk:snd sols)
                    else (fst sols, rowi:snd sols)

updaterow [] rowi distij = []
updaterow (distjk:restrowj) rowi distji
  = case rowi of
      (distik:restrowi) -> min distjk (distji + distik) : updaterow restrowj restrowi distji

m1 size = replicate size (enumFromTo 1 size)

-- splitIntoN :: Int -> [a] -> [[a]]
splitIntoN n xs =
  let l = length xs
      parts = zipWith (+) ((replicate (l `mod` n) 1) ++ repeat 0)
                          (replicate n (l `div` n))
  in takeIter parts xs

-- takeIter :: [Int] -> [a] -> [[a]]
takeIter []     xs = [] -- xs should always be []
takeIter (t:ts) xs = case splitAt t xs of
  (hs,rest) -> hs : takeIter ts rest

splitAt n xs = (take n xs, drop n xs)

-- scanl :: (b -> a -> b) -> b -> [a] -> [b]
scanl f q ls = q : (case ls of
                      []     -> []
                      (x:xs) -> scanl f (f q x) xs
                   )

foldl' f z []     = z
foldl' f z (x:xs) = let z' = f z x
                    in z' `seq` foldl' f z' xs

main =
  let res = wr2 10 (m1 10)
  in sum (map sum res)

