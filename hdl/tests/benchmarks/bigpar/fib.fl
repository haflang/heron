pfib n =
  if n <= 1
    then 1
    else if n <= threshold
           then fib n
           else let x = pfib (n - 2)
                    y = pfib (n - 1)
                in x `par` y + x

fib n =
  if n <= 1
    then 1
    else let x = fib (n - 2)
             y = fib (n - 1)
         in y + x

threshold = 10
main = pfib 25
